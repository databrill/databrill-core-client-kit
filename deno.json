{
	"exclude": [
		"tmp/"
	],
	"minimumDependencyAge": {
		"age": "P1D",
		"exclude": [
			"npm:@jsr/databrill__core-pg-kysely"
		]
	},
	"imports": {
		"effect": "npm:effect@4.1.2",
		"@databrill/core-pg-kysely": "npm:@jsr/databrill__core-pg-kysely@^0.1.19",
		"@effect/platform-node": "npm:@effect/platform-node@4.1.2",
		"@effect/platform-node-shared": "npm:@effect/platform-node-shared@4.1.2"
	},
	"tasks": {
		"fmt": "deno fmt",
		"fmt:check": "deno fmt --check",
		"lint": "deno lint",
		"check": "deno check --quiet",
		"static": "deno --quiet fmt && deno --quiet task check && deno --quiet task lint",
		"static:ci": "deno --quiet task fmt:check && deno --quiet task check && deno --quiet task lint",
		"ci": "deno task static:ci"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"semiColons": true,
		"singleQuote": false,
		"proseWrap": "preserve",
		"exclude": [
			"**/*.md"
		]
	},
	"lint": {
		"rules": {
			"tags": [
				"recommended"
			]
		}
	}
}
